	"scripts": {
		"open": "open -a Firefox 'http://localhost:8888'",
		"start": "wp-env start",
		"docker": "open -a Docker && while ! pgrep -i Docker > /dev/null; do sleep 0.5; done",
		"predev": "pnpm docker && wp-env start --update && pnpm open && pnpm dep",
		"dev": "wp-scripts start --hot --config webpack.config.ts; wp-env stop",
		"css-minify": "css-minify -f styles/admin.css -o styles",
		"prebuild": "pnpm dep && pnpm css-minify",
		"build": "wp-scripts build --config webpack.config.ts",
		"postbuild": "pnpm svn",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint": "eslint src --flag unstable_native_nodejs_ts_config",
		"lint:fix": "eslint src --fix --flag unstable_native_nodejs_ts_config",
		"lint:css": "npx stylelint **/*.css",
		"lint:css:fix": "npx stylelint **/*.css --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"zip": "pnpm build && wp-scripts plugin-zip",
		"stash": "wp-scripts build && wp-scripts plugin-zip",
		"dep": "cp ./node_modules/@aarsteinmedia/dotlottie-player/dist/unpkg-light.js ./scripts/dotlottie-player-light.min.js",
		"svn:copy-folders": "cp -R ./assets ./build ./includes ./scripts ./styles ./svn/trunk",
		"svn:copy-files": "cp ./am-lottieplayer.php ./LICENSE ./package.json ./readme.txt ./svn/trunk && cp ./blueprint.json ./svn/assets/blueprints",
		"svn": "rimraf ./svn/trunk/* && pnpm svn:copy-folders && pnpm svn:copy-files",
		"svn:update": "svn update ./svn/trunk ./svn/assets",
		"svn:stage": "svn status ./svn/trunk ./svn/assets | sed -n 's/^![[:space:]]*//p' | while read -r f; do svn delete --force \"$f\"; done; svn add ./svn/trunk ./svn/assets --force",
		"svn:commit": "svn commit ./svn/trunk ./svn/assets -m \"Release ${npm_package_version}\"",
		"svn:tag": "svn copy https://plugins.svn.wordpress.org/am-lottieplayer/trunk https://plugins.svn.wordpress.org/am-lottieplayer/tags/${npm_package_version} -m \"Tagging ${npm_package_version}\"",
		"deploy": "pnpm svn:update && pnpm svn:stage && pnpm svn:commit && pnpm svn:tag",
		"test": "pnpm test:e2e",
		"test:e2e": "WP_BASE_URL=http://localhost:8888 playwright test; wp-env stop",
		"test:e2e:ui": "WP_BASE_URL=http://localhost:8888 playwright test --ui; wp-env stop",
		"test:e2e:debug": "WP_BASE_URL=http://localhost:8888 playwright test --debug; wp-env stop",
		"clean": "pnpm pm clean && rm -rf test-results playwright-report vendor",
		"update": "pnpm pm update && composer update"
	},
	"cde": {
		"gettext": "am-lottieplayer",
		"prefix": "am"
	},
	"funding": {
		"type": "paypal",
		"url": "https://www.paypal.com/donate/?hosted_button_id=E7C7DMN8KSQ6A"
	}
}
