{
	"name": "am-lottieplayer",
	"version": "4.2.7",
	"description": "This is best free Lottie Player plugin. It is lightweight, versatile and easy to use, and it has integrations for Gutenberg, Divi, Elementor, Flatsome and WPBakery.",
	"type": "module",
	"author": {
		"name": "Aarstein Media",
		"email": "johan@aarstein.media",
		"url": "https://www.aarstein.media",
		"organization": "Aarstein Media"
	},
	"license": "GPL-3.0-or-later",
	"keywords": [
		"lottie",
		"bodymovin",
		"gutenberg",
		"svg",
		"gif"
	],
	"homepage": "https://wordpress.org/plugins/am-lottieplayer",
	"repository": {
		"type": "git",
		"url": "https://github.com/johanaarstein/am-lottieplayer"
	},
	"bugs": {
		"url": "https://github.com/johanaarstein/am-lottieplayer/issues",
		"email": "johan@aarstein.media"
	},
	"files": [
		"assets",
		"build",
		"includes",
		"scripts",
		"styles",
		"am-lottieplayer.php"
	],
	"main": "build/admin.js",
	"packageManager": "pnpm@12.18.0",
	"devDependencies": {
		"@aarsteinmedia/dotlottie-player": "^6.6.9",
		"@aarsteinmedia/lottie-web": "^1.6.10",
		"@eslint-react/eslint-plugin": "^5.28.8",
		"@eslint/compat": "^2.1.1",
		"@eslint/core": "^1.2.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@regru/eslint-plugin-prefer-early-return": "^1.0.0",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@types/eslint-plugin-jsx-a11y": "^6.10.1",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/webpack": "^5.28.5",
		"@types/wordpress__block-editor": "^15.0.9",
		"@wordpress/a11y": "^5.1.0",
		"@wordpress/api-fetch": "^8.1.0",
		"@wordpress/blob": "^5.1.0",
		"@wordpress/block-editor": "^20.0.0",
		"@wordpress/blocks": "^17.1.0",
		"@wordpress/browserslist-config": "^7.1.0",
		"@wordpress/components": "^44.0.0",
		"@wordpress/compose": "^9.1.0",
		"@wordpress/core-data": "^9.1.0",
		"@wordpress/data": "^11.1.0",
		"@wordpress/dom": "^5.1.0",
		"@wordpress/e2e-test-utils-playwright": "^3.2.0",
		"@wordpress/element": "^10.1.0",
		"@wordpress/env": "^12.1.0",
		"@wordpress/hooks": "^5.1.0",
		"@wordpress/i18n": "^7.1.0",
		"@wordpress/icons": "^20.0.0",
		"@wordpress/scripts": "^37.1.0",
		"@wordpress/ui": "^0.26.0",
		"classnames": "^2.5.1",
		"css-minify": "^2.1.0",
		"dotenv": "^18.0.9",
		"eslint": "^10.14.0",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-no-restricted": "^0.1.2",
		"eslint-plugin-fsecond": "^1.5.0",
		"eslint-plugin-import-x": "^4.18.0",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-perfectionist": "^5.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.7",
		"eslint-plugin-react-you-might-not-need-an-effect": "^1.1.0",
		"eslint-plugin-regexp": "^3.3.3",
		"eslint-plugin-sonarjs": "^4.2.2",
		"eslint-plugin-unicorn": "^79.0.0",
		"globals": "^17.14.0",
		"re-resizable": "^6.11.2",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rimraf": "^6.1.4",
		"stylelint": "^17.16.0",
		"stylelint-config-recommended": "^18.0.0",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1"
	},
	"scripts": {
		"open": "open -a Firefox 'http://localhost:8888'",
		"start": "wp-env start --runtime=playground --experimental-multi-worker",
		"predev": "wp-env start --runtime=playground --experimental-multi-worker --update && pnpm open && pnpm dep",
		"dev": "wp-scripts start --hot --config webpack.config.ts; wp-env stop",
		"css-minify": "css-minify -f styles/admin.css -o styles",
		"prebuild": "pnpm version:sync && pnpm dep && pnpm css-minify",
		"build": "wp-scripts build --config webpack.config.ts",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint": "eslint src --flag unstable_native_nodejs_ts_config",
		"lint:fix": "eslint src --fix --flag unstable_native_nodejs_ts_config",
		"lint:css": "npx stylelint **/*.css",
		"lint:css:fix": "npx stylelint **/*.css --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"zip": "pnpm build && wp-scripts plugin-zip",
		"release:prepare": "rimraf dist && wp-scripts plugin-zip && unzip -q am-lottieplayer.zip -d dist && rimraf am-lottieplayer.zip",
		"stash": "wp-scripts build && wp-scripts plugin-zip",
		"dep": "node ./copy-deps.ts",
		"version:sync": "node ./sync-version.ts",
		"test": "pnpm test:e2e",
		"test:e2e": "node tests/run-e2e.ts",
		"test:e2e:gutenberg": "node tests/run-e2e.ts gutenberg",
		"test:e2e:bricks": "node tests/run-e2e.ts bricks",
		"test:e2e:divi": "node tests/run-e2e.ts divi",
		"test:e2e:elementor": "node tests/run-e2e.ts elementor",
		"test:e2e:wpbakery": "node tests/run-e2e.ts wpbakery",
		"clean": "pnpm pm clean && rm -rf test-results playwright-report vendor dist build",
		"clear": "kill -9 $(lsof -t -i:8888)"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^24.22.2",
			"onFail": "download"
		}
	},
	"cde": {
		"gettext": "am-lottieplayer",
		"prefix": "am"
	},
	"funding": {
		"type": "paypal",
		"url": "https://www.paypal.com/donate/?hosted_button_id=E7C7DMN8KSQ6A"
	}
}
