{
	"name": "am-lottieplayer",
	"version": "3.7.1",
	"description": "This is best free Lottie Player plugin. It is lightweight, versatile and easy to use, and it has integrations for Gutenberg, Divi, Elementor, Flatsome and WPBakery.",
	"author": {
		"name": "Aarstein Media",
		"email": "johan@aarstein.media",
		"url": "https://www.aarstein.media",
		"organization": "Aarstein Media"
	},
	"license": "GPL-2.0-or-later",
	"keywords": [
		"lottie",
		"bodymovin",
		"gutenberg",
		"svg",
		"gif"
	],
	"homepage": "https://wordpress.org/plugins/am-lottieplayer",
	"repository": {
		"type": "git",
		"url": "https://github.com/johanaarstein/am-lottieplayer"
	},
	"bugs": {
		"url": "https://github.com/johanaarstein/am-lottieplayer/issues",
		"email": "johan@aarstein.media"
	},
	"files": [
		"assets",
		"build",
		"includes",
		"scripts",
		"styles",
		"am-lottieplayer.php"
	],
	"main": "build/admin.js",
	"devDependencies": {
		"@aarsteinmedia/dotlottie-player": "^6.3.10",
		"@aarsteinmedia/lottie-web": "^1.5.0",
		"@playwright/test": "^1.61.1",
		"@types/node": "^26.0.1",
		"@types/react": "^19.2.17",
		"@types/webpack": "^5.28.5",
		"@types/wordpress__block-editor": "^15.0.6",
		"@wordpress/a11y": "^4.49.0",
		"@wordpress/blob": "^4.49.0",
		"@wordpress/block-editor": "^15.22.0",
		"@wordpress/blocks": "^15.22.0",
		"@wordpress/browserslist-config": "^6.49.0",
		"@wordpress/components": "^33.1.0",
		"@wordpress/compose": "^7.46.0",
		"@wordpress/core-data": "^7.49.0",
		"@wordpress/data": "^10.49.0",
		"@wordpress/dom": "^4.49.0",
		"@wordpress/e2e-test-utils-playwright": "^1.49.0",
		"@wordpress/element": "^6.46.0",
		"@wordpress/env": "^11.9.0",
		"@wordpress/hooks": "^4.49.0",
		"@wordpress/i18n": "^6.22.0",
		"@wordpress/icons": "^14.0.1",
		"@wordpress/media-utils": "^5.49.0",
		"@wordpress/scripts": "^32.5.0",
		"classnames": "^2.5.1",
		"css-minify": "^2.1.0",
		"eslint": "^9.39.4",
		"eslint-config-sheriff": "^31.4.0",
		"eslint-plugin-perfectionist": "^5.9.1",
		"jiti": "^2.7.0",
		"re-resizable": "^6.11.2",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"rimraf": "^6.1.3",
		"stylelint": "^17.13.0",
		"stylelint-config-recommended": "^18.0.0",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"start": "wp-env start --update && open -a Firefox 'http://localhost:8888'",
		"dev": "pnpm start && pnpm dep && wp-scripts start --hot; wp-env stop",
		"css-minify": "css-minify -f styles/admin.css -o styles",
		"prebuild": "pnpm dep && pnpm css-minify",
		"build": "wp-scripts build",
		"postbuild": "pnpm svn",
		"check-engines": "wp-scripts check-engines",
		"check-licenses": "wp-scripts check-licenses",
		"format": "wp-scripts format",
		"lint:css": "npx stylelint **/*.css",
		"lint:css:fix": "npx stylelint **/*.css --fix",
		"lint:js": "eslint src",
		"lint:js:fix": "eslint src --fix",
		"lint:md:docs": "wp-scripts lint-md-docs",
		"lint:pkg-json": "wp-scripts lint-pkg-json",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"stash": "wp-scripts build && wp-scripts plugin-zip",
		"dep": "cp ./node_modules/@aarsteinmedia/dotlottie-player/dist/unpkg-light.js ./scripts/dotlottie-player-light.min.js",
		"svn:copy-folders": "cp -R ./assets ./build ./includes ./scripts ./styles ./svn/trunk",
		"svn:copy-files": "cp ./am-lottieplayer.php ./LICENSE ./package.json ./readme.txt ./svn/trunk && cp ./blueprint.json ./svn/assets/blueprints",
		"svn:new-version-folder": "rimraf ./svn/tags/${npm_package_version} && mkdir -p ./svn/tags/${npm_package_version}",
		"svn:new-version-files": "cp -R ./svn/trunk/* ./svn/tags/${npm_package_version}",
		"svn": "rimraf ./svn/trunk/* && pnpm svn:copy-folders && pnpm svn:copy-files && pnpm svn:new-version-folder && pnpm svn:new-version-files",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:debug": "playwright test --debug"
	},
	"cde": {
		"gettext": "am-lottieplayer",
		"prefix": "am"
	},
	"funding": {
		"type": "paypal",
		"url": "https://www.paypal.com/donate/?hosted_button_id=E7C7DMN8KSQ6A"
	}
}