{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./build",
    "target": "ES2023",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2023"
    ],
    "types": [
      "node",
      "react",
      "webpack",
      "wordpress__block-editor"
    ],
    "noImplicitAny": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@test/*": [
        "./tests/*"
      ]
    }
  },
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/svn",
    "**/build",
    "**/node_modules",
    "**/assets",
    "**/scripts"
  ]
}